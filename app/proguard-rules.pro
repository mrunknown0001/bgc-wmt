# R8 rules for release builds.
#
# Most libraries here ship their own consumer rules (Retrofit, OkHttp, Room,
# Hilt, Firebase, Coil), so this file covers what is specific to this app: the
# things reached by name rather than by a call R8 can see.

# --- Crash reports ---------------------------------------------------------
# Without these a release stack trace is a list of a(), b(), c(). Line numbers
# cost a little size and are the difference between a report worth reading and
# one that is not.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# Generic signatures and annotations: Retrofit reads the return type of each
# method reflectively, and loses it if Signature is stripped.
-keepattributes Signature,InnerClasses,EnclosingMethod,*Annotation*,RuntimeVisibleAnnotations,AnnotationDefault

# --- Moshi -----------------------------------------------------------------
# The reason this file exists. Adapters are generated by KSP and then found at
# runtime by name -- Moshi looks for <ModelName>JsonAdapter -- which is exactly
# the kind of link R8 cannot see. Strip one and nothing fails at build time:
# the app dies on the first screen that parses that response.
#
# The DTO package is kept whole rather than class by class, because a new DTO
# would otherwise be one forgotten rule away from the same crash.
-keep class com.wmt.app.data.remote.dto.** { *; }
-keep class com.wmt.app.data.remote.dto.**JsonAdapter { *; }
-keepnames @com.squareup.moshi.JsonClass class *
-keepclassmembers class * {
    @com.squareup.moshi.Json <fields>;
}
# Generated adapters take a Moshi in their constructor and are built by name.
-keepclassmembers class **JsonAdapter {
    <init>(com.squareup.moshi.Moshi);
    <init>(com.squareup.moshi.Moshi, java.lang.reflect.Type[]);
}

# --- Realtime (Pusher protocol / Soketi) -----------------------------------
# The client parses its own protocol messages reflectively and pulls in HTTP
# and WebSocket plumbing that R8 cannot fully trace.
-keep class com.pusher.** { *; }
-dontwarn com.pusher.**
-dontwarn org.java_websocket.**

# --- Kotlin ----------------------------------------------------------------
# Data classes with default constructor parameters are built through synthetic
# constructors that take a bitmask; Moshi's generated adapters call them.
-keepclassmembers class ** {
    public synthetic <init>(...);
}
-dontwarn kotlin.Unit
-dontwarn org.jetbrains.annotations.**

# The realtime client logs through slf4j, which looks up its binding by a class
# name that is not on the classpath -- there is no slf4j backend here, and it
# falls back to a no-op at runtime. R8 reports it as missing; this says so is
# expected. Generated by R8 itself into missing_rules.txt on the first run.
-dontwarn org.slf4j.impl.StaticLoggerBinder
