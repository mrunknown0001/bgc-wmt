<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      What the system paints before Compose has drawn anything: the launch
      splash, and the gap between activities. It is the app's own canvas
      (slate 50) rather than the platform's default near-white, so the splash
      hands over to the first frame without a step in brightness.

      Mirrored in values-night. These two are the only colours the framework
      reads; everything else lives in ui/theme, where the accent can reach it.
    -->
    <color name="window_background">#FFF8FAFC</color>
</resources>
