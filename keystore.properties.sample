# Copy to keystore.properties (which is gitignored) and fill in.
#
# storeFile is relative to the repository root. Keep the .jks itself outside the
# repository, or at least never commit it: Android identifies an app by the key that
# signed it, so if this key is lost no later build can update an app already installed,
# and if it leaks someone else can publish an update for you.
storeFile=../wmt-release.jks
storePassword=
keyAlias=wmt
keyPassword=
