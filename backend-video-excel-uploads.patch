diff --git a/app/Rules/CommentAttachmentFile.php b/app/Rules/CommentAttachmentFile.php
new file mode 100644
index 0000000..40c53eb
--- /dev/null
+++ b/app/Rules/CommentAttachmentFile.php
@@ -0,0 +1,54 @@
+<?php
+
+namespace App\Rules;
+
+use App\Models\Setting;
+use Closure;
+use Illuminate\Contracts\Validation\ValidationRule;
+use Illuminate\Http\UploadedFile;
+
+/**
+ * Validates a single comment attachment. Videos get their own fixed 50MB budget;
+ * documents/images/spreadsheets use the admin-configurable max_upload_size setting.
+ */
+class CommentAttachmentFile implements ValidationRule
+{
+    public const VIDEO_MAX_MB = 50;
+
+    private const VIDEO_EXTENSIONS = ['mp4', 'mov', 'webm', '3gp', 'mkv'];
+    private const DOCUMENT_EXTENSIONS = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'heic', 'heif', 'pdf', 'xlsx', 'xls', 'csv'];
+
+    public function validate(string $attribute, mixed $value, Closure $fail): void
+    {
+        if (! $value instanceof UploadedFile || ! $value->isValid()) {
+            $fail('The attachment failed to upload.');
+
+            return;
+        }
+
+        $extension = strtolower($value->getClientOriginalExtension());
+        $mime = (string) $value->getMimeType();
+        $sizeMb = $value->getSize() / 1024 / 1024;
+
+        $isVideo = in_array($extension, self::VIDEO_EXTENSIONS, true) || str_starts_with($mime, 'video/');
+
+        if ($isVideo) {
+            if ($sizeMb > self::VIDEO_MAX_MB) {
+                $fail(sprintf('Videos must not exceed %dMB.', self::VIDEO_MAX_MB));
+            }
+
+            return;
+        }
+
+        if (! in_array($extension, self::DOCUMENT_EXTENSIONS, true)) {
+            $fail('Only images (JPG, PNG, WebP, GIF, HEIC), PDF, Excel (XLSX/XLS), CSV, and video files are allowed.');
+
+            return;
+        }
+
+        $maxMb = Setting::current()->max_upload_size;
+        if ($sizeMb > $maxMb) {
+            $fail("Each file must not exceed {$maxMb}MB.");
+        }
+    }
+}
